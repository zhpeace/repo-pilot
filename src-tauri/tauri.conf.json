{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoPilot",
  "version": "0.2.0",
  "identifier": "com.hp.repo-pilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RepoPilot · 多仓管家",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQzY2NkFFNzdEQzI4QjcKUldTM0tOeDNybWJHM1JkZHRqNERjOUtqbkhEUDdMbjJEWmlBbFhpUzlhKzQxU05DK2puUWl5NkkK",
      "endpoints": [
        "https://github.com/zhpeace/repo-pilot/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
